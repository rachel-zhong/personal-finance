# Copy to .env.local and fill in from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# production (real banks; Trial plan) or sandbox (fake test banks)
PLAID_ENV=production
# Optional. Only needed if Plaid asks for an OAuth redirect URI (must be registered in the Plaid Dashboard).
PLAID_REDIRECT_URI=
# Optional overrides
# DATABASE_PATH=./data/finance.db
# SECRETS_PATH=./secrets/plaid-tokens.json
