{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "rachel-zhong (https://github.com/rachel-zhong)",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p 3000",
    "sync": "tsx scripts/sync.ts",
    "match-refunds": "tsx scripts/match-refunds.ts",
    "db:init": "tsx scripts/db-init.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "npm run demo:seed && NEXT_TELEMETRY_DISABLED=1 NEXT_DIST_DIR=.next-demo DATABASE_PATH=data/demo.db SECRETS_PATH=data/demo-secrets.json next dev -H 127.0.0.1 -p 3001",
    "phone": "sh scripts/phone.sh",
    "comp:import": "tsx scripts/compensation/import.ts",
    "comp:check": "tsx scripts/compensation/check.ts",
    "start:hosted": "NEXT_TELEMETRY_DISABLED=1 next start -H 0.0.0.0 -p ${PORT:-3000}",
    "hosted:upload": "tsx scripts/hosted/upload.ts",
    "hosted:authenticator": "tsx scripts/hosted/authenticator.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plaid-link": "^5.0.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
